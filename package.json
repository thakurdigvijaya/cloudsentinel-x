{
  "name": "cloudsentinel-x",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "CloudSentinel X — UTHO SmartCloud Optimizer (TransfiNITTe 2026). Synthetic data, illustrative pricing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/offline-smoke.cjs",
    "verify:source": "node scripts/verify-source.cjs",
    "test:bun": "bun test --preload ./scripts/bun-vitest-shim.ts src server",
    "typecheck:engine": "tsc --noEmit -p tsconfig.engine.json",
    "report": "tsx scripts/report.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "server": "tsx server/index.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "sample-data": "tsx scripts/sample-csv.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "6.4.5",
    "vitest": "5.0.5",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
